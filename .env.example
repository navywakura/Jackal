# =============================================================================
# Jackal (RXchat) — configuración de desarrollo
# Copiar a .env y ajustar. NUNCA commitear .env.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jackal
POSTGRES_USER=jackal
POSTGRES_PASSWORD=change_me_in_dev

# Rol de solo lectura que consume el servicio Elixir (ver ADR-0001)
POSTGRES_READONLY_USER=jackal_ro
POSTGRES_READONLY_PASSWORD=change_me_in_dev_ro

# --- ScyllaDB ----------------------------------------------------------------
SCYLLA_CONTACT_POINTS=localhost:9042
SCYLLA_KEYSPACE=jackal
SCYLLA_LOCAL_DC=datacenter1
# Factor de replicación: 1 en desarrollo (nodo único), 3 en producción
SCYLLA_REPLICATION_FACTOR=1

# --- Flask (API REST) --------------------------------------------------------
FLASK_ENV=development
API_BIND=0.0.0.0:8000
API_PUBLIC_URL=http://localhost:8000

# Semilla maestra para derivar la clave de firma Ed25519 de los JWT.
# En producción esto vive en un KMS/Vault, no en el entorno.
JWT_SIGNING_SEED_HEX=00000000000000000000000000000000000000000000000000000000deadbeef
JWT_ISSUER=https://api.jackal.local
JWT_AUDIENCE=jackal-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Parámetros Argon2id para el hash de contraseñas
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# --- Phoenix (Realtime) ------------------------------------------------------
PHX_HOST=localhost
PHX_PORT=4000
PHX_SECRET_KEY_BASE=generate_with_mix_phx_gen_secret
# URL del JWKS publicado por Flask; Phoenix lo cachea y valida los JWT en local
JWKS_URL=http://localhost:8000/.well-known/jwks.json
JWKS_CACHE_TTL_SECONDS=300
# Endpoint interno de Flask para invalidaciones de autorización
INTERNAL_API_URL=http://localhost:8000/internal
INTERNAL_API_TOKEN=change_me_internal_shared_secret

# --- Frontend (React) --------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:4000/socket

# --- WebRTC / TURN -----------------------------------------------------------
TURN_REALM=jackal.local
TURN_HOST=localhost
TURN_PORT=3478
# Secreto compartido para credenciales TURN efímeras (RFC 5766 REST API)
TURN_STATIC_AUTH_SECRET=change_me_turn_secret
TURN_CREDENTIAL_TTL_SECONDS=3600

# --- Almacenamiento de adjuntos ---------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=jackal-attachments
S3_ACCESS_KEY=jackal
S3_SECRET_KEY=change_me_s3
S3_REGION=us-east-1
